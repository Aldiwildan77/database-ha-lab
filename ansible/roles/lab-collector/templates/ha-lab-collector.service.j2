[Unit]
Description=ha-lab node collector ({{ db_engine }})
After=network-online.target {{ lab_db_service_unit }}

[Service]
User={{ lab_engine.collector.run_as }}
Group={{ lab_engine.collector.run_as }}
ExecStart=/usr/bin/python3 {{ lab_collector_dir }}/ha_lab_collector.py
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
