# Managed by database-ha-lab. Read only when the data directory is empty: initial-cluster* bootstrap a new cluster.
name: {{ inventory_hostname }}
data-dir: {{ pg_etcd_data_dir }}
listen-peer-urls: https://0.0.0.0:{{ pg_etcd_peer_port }}
listen-client-urls: https://0.0.0.0:{{ pg_etcd_client_port }}
initial-advertise-peer-urls: https://{{ node_fqdn }}:{{ pg_etcd_peer_port }}
advertise-client-urls: https://{{ node_fqdn }}:{{ pg_etcd_client_port }}
initial-cluster: {% for n in groups['db_nodes'] | sort %}{{ n }}=https://{{ hostvars[n].node_fqdn }}:{{ pg_etcd_peer_port }}{{ ',' if not loop.last }}{% endfor %}

initial-cluster-state: new
initial-cluster-token: {{ etcd_cluster_token }}
client-transport-security:
  cert-file: {{ pg_etcd_pki_dir }}/node.crt
  key-file: {{ pg_etcd_pki_dir }}/node.key
  trusted-ca-file: {{ pg_etcd_pki_dir }}/ca.crt
  client-cert-auth: true
peer-transport-security:
  cert-file: {{ pg_etcd_pki_dir }}/node.crt
  key-file: {{ pg_etcd_pki_dir }}/node.key
  trusted-ca-file: {{ pg_etcd_pki_dir }}/ca.crt
  client-cert-auth: true
logger: zap
log-outputs: [stderr]
