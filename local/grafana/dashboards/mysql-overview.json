      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mysql_global_status_uptime{environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\"}",
          "legendFormat": "{{node}}"
