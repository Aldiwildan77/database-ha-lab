{
  "uid": "lab-latency-breakdown",
  "title": "Latency Breakdown",
  "tags": [
    "database-ha-lab",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "ha_provider",
        "label": "HA provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ha_transaction_total, ha_provider)",
          "refId": "ha_provider"
        },
        "definition": "label_values(ha_transaction_total, ha_provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "scenario",
        "label": "Scenario",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ha_transaction_total{ha_provider=~\"$ha_provider\"}, scenario)",
          "refId": "scenario"
        },
        "definition": "label_values(ha_transaction_total{ha_provider=~\"$ha_provider\"}, scenario)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Benchmark runs",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 0.8)",
        "target": {
          "type": "tags",
          "tags": [
            "benchmark"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Durations below are measured **independently** and **overlap**; they do not add up to the end-to-end time. Client panels come from the JMeter sampler (`System.nanoTime()`); server panels from Performance Schema; storage from Performance Schema file I/O and `/proc/diskstats` (means, not distributions); network RTT from ICMP probes. Commit (server) already contains redo/binlog fsync and any replication acknowledgement wait."
      }
    },
    {
      "type": "row",
      "title": "End-to-end (client)",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "End-to-end transaction",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ha_transaction_duration_seconds_bucket{outcome=\"success\",ha_provider=~\"$ha_provider\",scenario=~\"$scenario\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ha_transaction_duration_seconds_bucket{outcome=\"success\",ha_provider=~\"$ha_provider\",scenario=~\"$scenario\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ha_transaction_duration_seconds_bucket{outcome=\"success\",ha_provider=~\"$ha_provider\",scenario=~\"$scenario\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
