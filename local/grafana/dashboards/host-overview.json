    {
      "type": "timeseries",
      "title": "Average I/O latency",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_disk_read_time_seconds_total{job=\"node\",environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval]) / rate(node_disk_reads_completed_total{job=\"node\",environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{device}} read"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
