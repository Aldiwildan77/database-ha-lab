          },
          "expr": "rate(node_disk_reads_completed_total{job=\"node\",environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval])",
