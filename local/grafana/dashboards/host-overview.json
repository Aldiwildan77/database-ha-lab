          },
          "expr": "rate(node_disk_write_time_seconds_total{job=\"node\",environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval]) / rate(node_disk_writes_completed_total{job=\"node\",environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{device}} write"
