    {
      "type": "timeseries",
      "title": "Replication lag",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "replication_lag_seconds{environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\"}",
          "legendFormat": "{{node}} applier"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mysql_slave_status_seconds_behind_source{environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\"} or mysql_slave_status_seconds_behind_master{environment=~\"$environment\",datacenter=~\"$datacenter\",node=~\"$node\"}",
          "legendFormat": "{{node}} Seconds_Behind_Source"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
